# PostgreSQL connection string (Neon, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/pantry

# Better Auth — must match the URL you open in the browser
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-stable-random-secret-at-least-32-characters

# Braintree Sandbox credentials (production Braintree is not supported)
BRAINTREE_ENVIRONMENT=Sandbox
BRAINTREE_MERCHANT_ID=your-sandbox-merchant-id
BRAINTREE_PUBLIC_KEY=your-sandbox-public-key
BRAINTREE_PRIVATE_KEY=your-sandbox-private-key

# Optional: Sandbox merchant account (currency / processing account)
# BRAINTREE_MERCHANT_ACCOUNT_ID=your-sandbox-merchant-account-id

# Optional: public site URL for metadata (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
